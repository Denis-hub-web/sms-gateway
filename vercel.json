{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/school-portal/dashboard", "destination": "/school-portal/dashboard.html" },
    { "source": "/school-portal/login", "destination": "/school-portal/login.html" },
    { "source": "/school-portal/register", "destination": "/school-portal/register.html" },
    { "source": "/school-portal", "destination": "/school-portal/login.html" },
    { "source": "/school-portal/", "destination": "/school-portal/login.html" },

    { "source": "/school", "destination": "/school-results-portal/index.html" },
    { "source": "/school/", "destination": "/school-results-portal/index.html" },
    { "source": "/school/index.html", "destination": "/school-results-portal/index.html" },

    { "source": "/admin-dashboard", "destination": "/admin-dashboard/index.html" },
    { "source": "/admin-dashboard/", "destination": "/admin-dashboard/index.html" },
    { "source": "/admin", "destination": "/admin-dashboard/index.html" },

    { "source": "/school-results-portal", "destination": "/school-results-portal/index.html" },
    { "source": "/school-results-portal/", "destination": "/school-results-portal/index.html" },
    { "source": "/results", "destination": "/school-results-portal/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
